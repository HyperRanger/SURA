DATABASE_URL=postgresql://<username>:<password>@<hostname>:5432/<database>
SECRET_KEY=<generate-with-python-secrets-token-urlsafe-48>
JWT_ALGORITHM=HS256
DEMO_OTP_CODE=<demo-only-otp>
ENVIRONMENT=development

# PostgreSQL connection reuse. These defaults suit the small Render demo
# instance; increase only after measuring database capacity and web concurrency.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1500

# One-time code delivery. Codes are generated and verified by this service and
# Termii only carries the message, so signup and login keep their expiry, attempt
# caps and single-use guarantees.
#
# Without a key, non-production runs on a null provider and returns the code in
# the response as `demo_code`. Production refuses to start without one.
TERMII_API_KEY=<from-termii-dashboard>
# The API host is account-specific, so it comes from the Termii dashboard rather
# than a default.
TERMII_BASE_URL=https://api.termii.com
# Must be a sender ID Termii has approved for the account.
TERMII_SENDER_ID=Sura
# Transactional channel. Never set this to `generic`: that is marketing traffic,
# and a login code on it is both misclassified and more likely to be filtered.
TERMII_CHANNEL=dnd

# Bank Portal sign-in. Staff authenticate with an email and password, then a
# one-time code sent to the phone on their staff record.
BANK_MFA_REQUIRED=true
BANK_LOGIN_MAX_PASSWORD_ATTEMPTS=5
BANK_LOGIN_LOCKOUT_SECONDS=900

# Authenticated exact-contact resolution is capped per member to prevent the
# group-builder from becoming an account-discovery directory. These defaults
# are deliberately conservative; tune at the deployment environment, never in
# frontend code.
CONTACT_LOOKUP_MAX_ATTEMPTS=10
CONTACT_LOOKUP_WINDOW_SECONDS=900

# Required only for local Docker Compose.
POSTGRES_USER=<local-postgres-user>
POSTGRES_PASSWORD=<local-postgres-password>
POSTGRES_DB=<local-postgres-database>
PGADMIN_DEFAULT_EMAIL=<local-pgadmin-email>
PGADMIN_DEFAULT_PASSWORD=<local-pgadmin-password>
