NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEMO_OTP_CODE=
# Opt in only for an isolated, seeded hackathon demo deployment. This shows
# the backend-provided demo OTP on the verification screen. Never use it with
# real customer accounts.
NEXT_PUBLIC_DEMO_MODE=false
# Must match the backend SESSION_IDLE_TIMEOUT_SECONDS setting. The browser
# clears the local session at this inactivity boundary; the backend remains
# authoritative and also rejects expired sessions with 401.
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_SECONDS=300
# Local only. Production always uses https://sura-seven.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:4321
